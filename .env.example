TOKENSRE_ENV=development
TOKENSRE_GATEWAY_TOKEN=replace-with-secret-manager-reference
TOKENSRE_UPSTREAM_TIMEOUT=60
TOKENSRE_CIRCUIT_FAILURES=3
TOKENSRE_CIRCUIT_RECOVERY_SECONDS=30
AZURE_FOUNDRY_API_KEY=replace-with-secret-manager-reference
OPENROUTER_API_KEY=replace-with-secret-manager-reference
NVIDIA_NIM_API_KEY=replace-with-secret-manager-reference
TOKENSRE_BACKEND_SELF_HOSTED_NIM_BASE_URL=https://your-nim-endpoint.example.com
TOKENSRE_BACKEND_SELF_HOSTED_NIM_API_KEY_ENV=NVIDIA_NIM_API_KEY
TOKENSRE_BACKEND_AZURE_FOUNDRY_ROUTER_BASE_URL=https://your-foundry-endpoint.example.com
TOKENSRE_BACKEND_AZURE_FOUNDRY_ROUTER_API_KEY_ENV=AZURE_FOUNDRY_API_KEY
